#!/usr/bin/env bash
# Tekhton pipeline.conf — Project-specific configuration
#
# Place this file at:  <your-project>/.claude/pipeline.conf
# Lines starting with # are comments. Empty lines are ignored.
# Format: KEY=value (no spaces around =, quote strings with spaces)
#
# Review the Essential section below — most users only need the first 20 lines.
# All other sections have sensible defaults.

# Tekhton config version (do not edit manually)
# TEKHTON_CONFIG_VERSION="3.22"

PROJECT_NAME="My Project"
TEST_CMD="echo 'No test command configured — set TEST_CMD in pipeline.conf'"
ANALYZE_CMD="echo 'No analyze command configured — set ANALYZE_CMD in pipeline.conf'"
BUILD_CHECK_CMD=""
ARCHITECTURE_FILE="ARCHITECTURE.md"
PROJECT_RULES_FILE="CLAUDE.md"
# DESIGN_FILE=".tekhton/DESIGN.md"

# Tekhton artifact directory — all pipeline-managed files live here.
# CLAUDE.md stays at the project root (Claude Code requires it there).
# TEKHTON_DIR=".tekhton"

# ═══════════════════════════════════════════════════════════════════════════════
# Section 2: Models & Turns
# Defaults work well — tune after a few runs if needed
# ═══════════════════════════════════════════════════════════════════════════════

CLAUDE_STANDARD_MODEL="claude-sonnet-4-6"
CLAUDE_CODER_MODEL="claude-opus-4-6"
CLAUDE_JR_CODER_MODEL="claude-haiku-4-5"
CLAUDE_SCOUT_MODEL="claude-haiku-4-5"
CLAUDE_REVIEWER_MODEL="claude-sonnet-4-6"
CLAUDE_ARCHITECT_MODEL="claude-sonnet-4-6"
CLAUDE_TESTER_MODEL="claude-haiku-4-5"

CODER_MAX_TURNS=35
JR_CODER_MAX_TURNS=15
REVIEWER_MAX_TURNS=10
TESTER_MAX_TURNS=30
SCOUT_MAX_TURNS=20
DYNAMIC_TURNS_ENABLED=true

# Milestone mode overrides (uncomment to customize):
# MILESTONE_MAX_REVIEW_CYCLES=4
# MILESTONE_CODER_MAX_TURNS=70
# MILESTONE_JR_CODER_MAX_TURNS=30
# MILESTONE_REVIEWER_MAX_TURNS=15
# MILESTONE_TESTER_MAX_TURNS=60
# MILESTONE_TESTER_MODEL="claude-sonnet-4-6"
# MILESTONE_ACTIVITY_TIMEOUT_MULTIPLIER=3

# ═══════════════════════════════════════════════════════════════════════════════
# Section 3: Pipeline Behavior
# Advanced — most users never change these
# ═══════════════════════════════════════════════════════════════════════════════

REQUIRED_TOOLS="claude git"
MAX_REVIEW_CYCLES=2
CONTEXT_BUDGET_ENABLED=true
CONTEXT_BUDGET_PCT=50
CHARS_PER_TOKEN=4
CONTEXT_COMPILER_ENABLED=false

# Error pattern matching
ANALYZE_ERROR_PATTERN="error"
BUILD_ERROR_PATTERN="ERROR"

# Clarification and replanning
# CLARIFICATION_ENABLED=true
# REPLAN_ENABLED=true
# REPLAN_MODEL="opus"
# REPLAN_MAX_TURNS=50

# Turn exhaustion continuation
# CONTINUATION_ENABLED=true
# MAX_CONTINUATION_ATTEMPTS=3

# Transient error retry
# TRANSIENT_RETRY_ENABLED=true
# MAX_TRANSIENT_RETRIES=3
# TRANSIENT_RETRY_BASE_DELAY=30
# TRANSIENT_RETRY_MAX_DELAY=120

# Planning phase
# PLAN_INTERVIEW_MODEL="sonnet"
# PLAN_GENERATION_MODEL="sonnet"
# PLAN_INTERVIEW_MAX_TURNS=50
# PLAN_GENERATION_MAX_TURNS=30

# Human notes
NOTES_FILTER_CATEGORIES="BUG|FEAT|POLISH"

# Drift detection
# DRIFT_LOG_FILE=".tekhton/DRIFT_LOG.md"
# ARCHITECTURE_LOG_FILE=".tekhton/ARCHITECTURE_LOG.md"
# HUMAN_ACTION_FILE=".tekhton/HUMAN_ACTION_REQUIRED.md"
DRIFT_OBSERVATION_THRESHOLD=8
DRIFT_RUNS_SINCE_AUDIT_THRESHOLD=5
# NON_BLOCKING_LOG_FILE=".tekhton/NON_BLOCKING_LOG.md"
NON_BLOCKING_INJECTION_THRESHOLD=8

# Architect agent
ARCHITECT_ROLE_FILE=".claude/agents/architect.md"
ARCHITECT_MAX_TURNS=25
DEPENDENCY_CONSTRAINTS_FILE=""

# Dynamic turn bounds
# CODER_MIN_TURNS=15
# CODER_MAX_TURNS_CAP=200
# REVIEWER_MIN_TURNS=10
# REVIEWER_MAX_TURNS_CAP=30
# TESTER_MIN_TURNS=10
# TESTER_MAX_TURNS_CAP=100

# Agent exit detection
# AGENT_NULL_RUN_THRESHOLD=2
# AGENT_FILE_SCAN_DEPTH=8

# ═══════════════════════════════════════════════════════════════════════════════
# Section 4: Security
# Security is ON by default — adjust policy to your risk tolerance
# ═══════════════════════════════════════════════════════════════════════════════

# SPECIALIST_SECURITY_ENABLED=false
# SPECIALIST_SECURITY_MODEL="claude-sonnet-4-6"
# SPECIALIST_SECURITY_MAX_TURNS=8

# SPECIALIST_PERFORMANCE_ENABLED=false
# SPECIALIST_PERFORMANCE_MODEL="claude-sonnet-4-6"
# SPECIALIST_PERFORMANCE_MAX_TURNS=8

# SPECIALIST_API_ENABLED=false
# SPECIALIST_API_MODEL="claude-sonnet-4-6"
# SPECIALIST_API_MAX_TURNS=8

# AGENT_SKIP_PERMISSIONS=false

# Docs agent stage — optional post-coder/pre-security stage
# Uses Haiku to update README/docs/ based on the coder's diff
# DOCS_AGENT_ENABLED=false
# DOCS_AGENT_MODEL="claude-haiku-4-5-20251001"
# DOCS_AGENT_MAX_TURNS=10

# ═══════════════════════════════════════════════════════════════════════════════
# Section 5: Features
# Optional features — enable as needed
# ═══════════════════════════════════════════════════════════════════════════════

# REPO_MAP_ENABLED=false
# REPO_MAP_TOKEN_BUDGET=2048
# REPO_MAP_CACHE_DIR=".claude/index"
# REPO_MAP_LANGUAGES="auto"
# REPO_MAP_VENV_DIR=".claude/indexer-venv"
# REPO_MAP_HISTORY_ENABLED=true

# SERENA_ENABLED=false
# SERENA_PATH=".claude/serena"
# SERENA_LANGUAGE_SERVERS="auto"
# SERENA_STARTUP_TIMEOUT=30

# DASHBOARD_ENABLED=true
# DASHBOARD_REFRESH_INTERVAL=5
# DASHBOARD_MAX_TIMELINE_EVENTS=500
# DASHBOARD_HISTORY_DEPTH=50
# DASHBOARD_VERBOSITY="normal"
# Dashboard data lives in .claude/dashboard — add to .gitignore if desired

# --- UI Testing (Milestone 28) ---
# UI_TEST_CMD=""                  # E2E test command (e.g., "npx playwright test")
# UI_FRAMEWORK=""                 # auto | playwright | cypress | selenium | puppeteer | testing-library | detox
# UI_VALIDATION_ENABLED=true      # Enable UI validation gate when UI detected
# UI_TEST_TIMEOUT=120             # Seconds before UI test gate times out

# ─── Resilience arc (m126–m131): UI gate robustness & build-fix recovery ─────

# UI gate non-interactive enforcement
# Enable auto-retry with non-interactive env when gate times out (interactive reporter detection).
# UI_GATE_ENV_RETRY_ENABLED=true

# Fraction of UI_TEST_TIMEOUT to allow for the non-interactive retry run (0.1–1.0).
# Lower values fail faster when the fix didn't work; higher values allow longer retry.
# UI_GATE_ENV_RETRY_TIMEOUT_FACTOR=0.5

# TEKHTON_UI_GATE_FORCE_NONINTERACTIVE=0
# ^ Auto-set to 1 when running inside CI (GitHub Actions, GitLab CI, CircleCI,
#   Jenkins, Azure DevOps, Buildkite, TeamCity, Bitbucket, Travis, CI=true).
#   Uncomment and set to 0 to suppress the auto-override in CI.
#   Uncomment and set to 1 to force non-interactive mode locally.

# Build-fix continuation loop
# Enable the build-fix continuation loop (attempts to fix build errors automatically).
# BUILD_FIX_ENABLED=true

# Maximum number of build-fix attempts per pipeline cycle.
# BUILD_FIX_MAX_ATTEMPTS=3

# Attempt-1 budget divisor. M128 computes the base budget as
# EFFECTIVE_CODER_MAX_TURNS / BUILD_FIX_BASE_TURN_DIVISOR.
# BUILD_FIX_BASE_TURN_DIVISOR=3

# Cap the adaptive schedule at EFFECTIVE_CODER_MAX_TURNS * multiplier.
# Encoded as integer percent (100 = 1.0×) to match the M128 runtime contract.
# BUILD_FIX_MAX_TURN_MULTIPLIER=100

# Require measurable progress before continuing to later build-fix attempts.
# BUILD_FIX_REQUIRE_PROGRESS=true

# Cumulative cap across the whole build-fix loop.
# BUILD_FIX_TOTAL_TURN_CAP=120

# Require log classification to be code_dominant before allowing build-fix loop.
# Set to false to attempt build-fix even on mixed/uncertain logs (not recommended).
# BUILD_FIX_CLASSIFICATION_REQUIRED=true

# Preflight UI config audit
# Scan test framework config files (playwright.config.ts, etc.) for interactive-mode settings.
# PREFLIGHT_UI_CONFIG_AUDIT_ENABLED=true

# Auto-patch detected interactive reporter config (e.g. reporter: 'html' → CI-guarded form).
# PREFLIGHT_UI_CONFIG_AUTO_FIX=true

# Maximum number of backup files to keep in .claude/preflight_bak/ (0 = keep all).
# PREFLIGHT_BAK_RETAIN_COUNT=5

# --- UI Validation (Milestone 29: headless browser smoke tests) ---
# UI_SERVE_CMD=""                    # Dev server command (e.g., "npm run dev")
# UI_SERVE_PORT=3000                 # Dev server port
# UI_SERVER_STARTUP_TIMEOUT=30       # Seconds to wait for server ready
# UI_VALIDATION_VIEWPORTS="1280x800,375x812"  # Viewport sizes
# UI_VALIDATION_TIMEOUT=30           # Seconds per page load timeout
# UI_VALIDATION_CONSOLE_SEVERITY=error  # error | warn
# UI_VALIDATION_FLICKER_THRESHOLD=0.05  # Pixel diff ratio for flicker warning
# UI_VALIDATION_RETRY=true           # Retry once on failure before rework
# UI_VALIDATION_SCREENSHOTS=true     # Save screenshots for review
# WATCHTOWER_SELF_TEST=true          # Auto-test dashboard when Watchtower enabled

SEED_CONTRACTS_ENABLED=false
# INLINE_CONTRACT_PATTERN=""
# INLINE_CONTRACT_SEARCH_CMD=""

# INTAKE_AGENT_ENABLED=true
# CLAUDE_INTAKE_MODEL="opus"
# INTAKE_MAX_TURNS=10
# INTAKE_CLARITY_THRESHOLD=40
# INTAKE_TWEAK_THRESHOLD=70

# CLEANUP_ENABLED=false
# CLEANUP_BATCH_SIZE=5
# CLEANUP_MAX_TURNS=15
# CLEANUP_TRIGGER_THRESHOLD=5

# MILESTONE_DAG_ENABLED=true
# MILESTONE_DIR=".claude/milestones"
# MILESTONE_MANIFEST="MANIFEST.cfg"
# MILESTONE_AUTO_MIGRATE=true
# MILESTONE_WINDOW_PCT=30
# MILESTONE_WINDOW_MAX_CHARS=20000
# MILESTONE_SPLIT_ENABLED=true
# MILESTONE_SPLIT_MODEL="claude-opus-4-6"
# MILESTONE_SPLIT_MAX_TURNS=15
# MILESTONE_SPLIT_THRESHOLD_PCT=120
# MILESTONE_AUTO_RETRY=true
# MILESTONE_MAX_SPLIT_DEPTH=3

# --- Auto-fix on test failure ---
# TESTER_FIX_ENABLED=false          # Auto-seed a fix run when tests fail (opt-in)
# TESTER_FIX_MAX_DEPTH=1            # Max recursive fix attempts (prevents infinite loops)
# TESTER_FIX_OUTPUT_LIMIT=4000      # Max chars of test output in fix task string

# TEST_BASELINE_ENABLED=true
# TEST_BASELINE_PASS_ON_PREEXISTING=false   # M92: default — pre-existing failures no longer auto-pass.
                                            # Set to true only if you genuinely cannot fix some tests (masks failures).

# --- Pre-coder clean sweep (M92) ---
# Before the coder runs, check if tests pass. If not, spawn a restricted fix
# agent to restore a clean baseline. The fix is non-fatal — if it cannot
# clean the suite, the coder proceeds and the stricter post-run gates surface
# the breakage. Disable for projects with intentionally failing tests.
# PRE_RUN_CLEAN_ENABLED=true
# PRE_RUN_FIX_MAX_TURNS=20
# PRE_RUN_FIX_MAX_ATTEMPTS=1

# ═══════════════════════════════════════════════════════════════════════════════
# Section 6: Quotas & Autonomy
# Controls for autonomous mode (--complete, --auto-advance)
# ═══════════════════════════════════════════════════════════════════════════════

# COMPLETE_MODE_ENABLED=true
# MAX_PIPELINE_ATTEMPTS=5
# AUTONOMOUS_TIMEOUT=7200
# MAX_AUTONOMOUS_AGENT_CALLS=20
# AUTONOMOUS_PROGRESS_CHECK=true

# AUTO_ADVANCE_ENABLED=false
# AUTO_ADVANCE_LIMIT=3
# AUTO_ADVANCE_CONFIRM=true
# MILESTONE_TAG_ON_COMPLETE=false

# USAGE_THRESHOLD_PCT=0
# AUTO_COMMIT=true

# ═══════════════════════════════════════════════════════════════════════════════
# Section 7: Paths & Files
# File paths — rarely need changing
# ═══════════════════════════════════════════════════════════════════════════════

PIPELINE_STATE_FILE=".claude/PIPELINE_STATE.md"
LOG_DIR=".claude/logs"
CODER_ROLE_FILE=".claude/agents/coder.md"
REVIEWER_ROLE_FILE=".claude/agents/reviewer.md"
TESTER_ROLE_FILE=".claude/agents/tester.md"
JR_CODER_ROLE_FILE=".claude/agents/jr-coder.md"
# MIGRATION_AUTO=true

# ═══════════════════════════════════════════════════════════════════════════════
# Section 8: Human Notes Triage
# Sizing gate for human notes — detects oversized notes and offers promotion
# ═══════════════════════════════════════════════════════════════════════════════

# HUMAN_NOTES_TRIAGE_ENABLED=true          # Run triage gate before note execution
# HUMAN_NOTES_TRIAGE_MODEL=haiku           # Model for agent escalation (haiku recommended)
# HUMAN_NOTES_PROMOTE_THRESHOLD=20         # Est. turns above which to recommend promotion
# HUMAN_NOTES_PROMOTE_MODE=confirm         # confirm = ask user; auto = promote silently




# =============================================================================
# Tekhton pipeline.conf — Full Configuration Reference
#
# Every Tekhton-recognized variable is listed below as a commented line with
# its default value. Uncomment any line to override the default for this
# project. Custom values you add are preserved by `tekhton --reinit`.
#
# Format: KEY="value" (no spaces around =, quote strings, no trailing comments
# on the same line as a KEY=).
#
# Variables are grouped into logical sections. Within each section, keys are
# alphabetical for findability. The init generator produces a curated header
# above this reference with the variables most projects need to set first
# (PROJECT_NAME, TEST_CMD, ANALYZE_CMD, ARCHITECTURE_FILE).
# =============================================================================

# =============================================================================
# Project Identity & Paths  (13 variables)
# PROJECT_NAME, description, root paths, and which files Tekhton reads for context.
# =============================================================================

# ARCHITECTURE_FILE=""

# DESIGN_FILE=".tekhton/DESIGN.md"

# INIT_AUTO_PROMPT="false"

# MIGRATION_AUTO="true"

# PROJECT_DESCRIPTION="multi-agent development pipeline"

# PROJECT_INDEX_BUDGET="120000"

# PROJECT_RULES_FILE="CLAUDE.md"

# PROJECT_STRUCTURE="single"

# TEKHTON_CONFIG_VERSION=""

# TEKHTON_DIR=".tekhton"

# TEKHTON_EXPRESS_ENABLED="true"

# TEKHTON_PIN_VERSION=""

# TEKHTON_UPDATE_CHECK="true"

# =============================================================================
# Commands (Build / Test / Analyze)  (4 variables)
# The commands Tekhton runs in the build and completion gates. Set these per project.
# =============================================================================

# ANALYZE_ERROR_PATTERN="error"

# BUILD_CHECK_CMD=""

# TEST_CMD="true"

# UI_TEST_CMD=""

# =============================================================================
# Project Versioning  (6 variables)
# Auto-bump strategy and version-file targets for the project under management.
# =============================================================================

# PROJECT_VERSION_AUTO_DETECT="true"

# PROJECT_VERSION_CONFIG=".claude/project_version.cfg"

# PROJECT_VERSION_DEFAULT_BUMP="patch"

# PROJECT_VERSION_ENABLED="true"

# PROJECT_VERSION_STRATEGY="semver"

# PROJECT_VERSION_TAG_ON_BUMP="false"

# =============================================================================
# Models  (14 variables)
# Which Claude model each agent uses. Defaults to a balanced sonnet/haiku mix.
# =============================================================================

# ARTIFACT_MERGE_MODEL="claude-sonnet-4-6"

# CLAUDE_ARCHITECT_MODEL="claude-sonnet-4-6"

# CLAUDE_CODER_MODEL="claude-sonnet-4-6"

# CLAUDE_INTAKE_MODEL="claude-sonnet-4-6"

# CLAUDE_JR_CODER_MODEL="claude-sonnet-4-6"

# CLAUDE_QUOTA_CHECK_CMD=""

# CLAUDE_REVIEWER_MODEL="claude-sonnet-4-6"

# CLAUDE_SCOUT_MODEL="claude-sonnet-4-6"

# CLAUDE_SECURITY_MODEL="claude-sonnet-4-6"

# CLAUDE_STANDARD_MODEL="claude-sonnet-4-6"

# CLAUDE_TESTER_MODEL="claude-sonnet-4-6"

# DRAFT_MILESTONES_MODEL="claude-sonnet-4-6"

# MILESTONE_SPLIT_MODEL="claude-sonnet-4-6"

# REPLAN_MODEL="opus"

# =============================================================================
# Agent Turn Budgets  (21 variables)
# Maximum agent turns per stage. DYNAMIC_TURNS_ENABLED lets scout adjust these per run; REWORK_TURN_ESCALATION_* increases budgets after consecutive max-turn exits.
# =============================================================================

# ARCHITECT_MAX_TURNS="25"

# ARTIFACT_MERGE_MAX_TURNS="10"

# BUG_TURN_MULTIPLIER="1.0"

# CLEANUP_MAX_TURNS="15"

# CODER_MAX_TURNS="80"

# DOCS_AGENT_MAX_TURNS="10"

# DRAFT_MILESTONES_MAX_TURNS="40"

# DYNAMIC_TURNS_ENABLED="true"

# FEAT_TURN_MULTIPLIER="1.0"

# FINAL_FIX_MAX_TURNS="26"

# INTAKE_MAX_TURNS="10"

# JR_CODER_MAX_TURNS="40"

# PRE_RUN_FIX_MAX_TURNS="20"

# REVIEWER_MAX_TURNS="20"

# REWORK_TURN_ESCALATION_ENABLED="true"

# REWORK_TURN_ESCALATION_FACTOR="1.5"

# REWORK_TURN_MAX_CAP="200"

# SCOUT_MAX_TURNS="20"

# SECURITY_MAX_TURNS="15"

# SEED_CONTRACTS_MAX_TURNS="20"

# TESTER_MAX_TURNS="50"

# =============================================================================
# Milestone Mode  (21 variables)
# Overrides applied when running in --milestone mode (typically larger budgets, stricter checks).
# =============================================================================

# MILESTONE_ACTIVITY_TIMEOUT_MULTIPLIER="3"

# MILESTONE_ARCHITECT_MAX_TURNS="50"

# MILESTONE_AUTO_MIGRATE="true"

# MILESTONE_AUTO_RETRY="true"

# MILESTONE_CODER_MAX_TURNS="160"

# MILESTONE_DAG_ENABLED="true"

# MILESTONE_DIR=".claude/milestones"

# MILESTONE_JR_CODER_MAX_TURNS="80"

# MILESTONE_MANIFEST="MANIFEST.cfg"

# MILESTONE_MAX_REVIEW_CYCLES="6"

# MILESTONE_MAX_SPLIT_DEPTH="6"

# MILESTONE_REVIEWER_MAX_TURNS="25"

# MILESTONE_SECURITY_MAX_TURNS="30"

# MILESTONE_SPLIT_ENABLED="true"

# MILESTONE_SPLIT_MAX_TURNS="15"

# MILESTONE_SPLIT_THRESHOLD_PCT="120"

# MILESTONE_TAG_ON_COMPLETE="false"

# MILESTONE_TESTER_MAX_TURNS="100"

# MILESTONE_TESTER_MODEL="claude-sonnet-4-6"

# MILESTONE_WINDOW_MAX_CHARS="20000"

# MILESTONE_WINDOW_PCT="30"

# =============================================================================
# Auto-Advance & Autonomous Run  (8 variables)
# Controls for --auto-advance milestone chaining and --complete autonomous mode.
# =============================================================================

# AUTONOMOUS_PROGRESS_CHECK="true"

# AUTONOMOUS_TIMEOUT="7200"

# AUTO_ADVANCE_CONFIRM="true"

# AUTO_ADVANCE_ENABLED="false"

# AUTO_ADVANCE_LIMIT="3"

# COMPLETE_MODE_ENABLED="true"

# MAX_AUTONOMOUS_AGENT_CALLS="200"

# MAX_PIPELINE_ATTEMPTS="5"

# =============================================================================
# Retries & Continuation  (7 variables)
# Transient-error retry and turn-exhaustion continuation policy across stages.
# =============================================================================

# CONTINUATION_ENABLED="true"

# MAX_CONTINUATION_ATTEMPTS="3"

# MAX_REVIEW_CYCLES="3"

# MAX_TRANSIENT_RETRIES="3"

# TRANSIENT_RETRY_BASE_DELAY="30"

# TRANSIENT_RETRY_ENABLED="true"

# TRANSIENT_RETRY_MAX_DELAY="120"

# =============================================================================
# Pipeline Stage Order  (2 variables)
# Configurable stage order (standard vs test_first) and stage-level toggles.
# =============================================================================

# PIPELINE_ORDER="standard"

# PIPELINE_STATE_FILE=".claude/PIPELINE_STATE.md"

# =============================================================================
# Build Gate & Build-Fix Loop  (18 variables)
# Build verification after the coder stage and the M127/M128 multi-attempt build-fix continuation loop.
# =============================================================================

# BUILD_ERRORS_FILE=".tekhton/BUILD_ERRORS.md"

# BUILD_ERROR_PATTERN="ERROR"

# BUILD_FIX_BASE_TURN_DIVISOR="3"

# BUILD_FIX_CLASSIFICATION_REQUIRED="true"

# BUILD_FIX_ENABLED="true"

# BUILD_FIX_MAX_ATTEMPTS="3"

# BUILD_FIX_MAX_TURN_MULTIPLIER="100"

# BUILD_FIX_REPORT_FILE=".tekhton/BUILD_FIX_REPORT.md"

# BUILD_FIX_REQUIRE_PROGRESS="true"

# BUILD_FIX_TOTAL_TURN_CAP="120"

# BUILD_GATE_ANALYZE_TIMEOUT="300"

# BUILD_GATE_COMPILE_TIMEOUT="120"

# BUILD_GATE_CONSTRAINT_TIMEOUT="60"

# BUILD_GATE_TIMEOUT="600"

# BUILD_RAW_ERRORS_FILE=".tekhton/BUILD_RAW_ERRORS.txt"

# BUILD_ROUTING_DIAGNOSIS_FILE=".tekhton/BUILD_ROUTING_DIAGNOSIS.md"

# FINAL_FIX_ENABLED="true"

# FINAL_FIX_MAX_ATTEMPTS="2"

# =============================================================================
# Test Gate, Audit, Baseline  (19 variables)
# Completion gate TEST_CMD execution, M88/M92 audit, baseline diffing, dedup fingerprint, pre-coder test-state cleanup.
# =============================================================================

# COMPLETION_GATE_TEST_ENABLED="true"

# m45 — Grace + retry tuning. Defaults eliminate the observed false-halt
# pattern on WSL2 after large refactors (file-system flush, stale dedup
# fingerprint, port collision). Lower if your file system is faster;
# raise if your CI runner is slower.
# COMPLETION_GATE_GRACE_SECS="3"          # Seconds to sleep + fsync before
#                                         # the first TEST_CMD invocation.
#                                         # Range 0–60. 0 disables.
# COMPLETION_GATE_RETRY_NO_BASELINE="true"  # When true, a non-zero TEST_CMD
#                                           # exit on the no-baseline path
#                                           # retries once after the delay
#                                           # below. Set false to revert
#                                           # to pre-m45 single-attempt
#                                           # behavior.
# COMPLETION_GATE_RETRY_DELAY_SECS="5"    # Seconds between the failed
#                                         # first attempt and the retry.
#                                         # Range 0–60.

# PRE_RUN_CLEAN_ENABLED="true"

# PRE_RUN_FIX_MAX_ATTEMPTS="1"

# TEST_AUDIT_ENABLED="true"

# TEST_AUDIT_HISTORY_MAX_RECORDS="500"

# TEST_AUDIT_MAX_REWORK_CYCLES="1"

# TEST_AUDIT_MAX_TURNS="15"

# TEST_AUDIT_ORPHAN_DETECTION="true"

# TEST_AUDIT_REPORT_FILE=".tekhton/TEST_AUDIT_REPORT.md"

# TEST_AUDIT_ROLLING_ENABLED="true"

# TEST_AUDIT_ROLLING_SAMPLE_K="3"

# TEST_AUDIT_SYMBOL_MAP_ENABLED="true"

# TEST_AUDIT_WEAKENING_DETECTION="true"

# TEST_BASELINE_ENABLED="true"

# TEST_BASELINE_PASS_ON_PREEXISTING="false"

# TEST_BASELINE_PASS_ON_STUCK="false"

# TEST_BASELINE_STUCK_THRESHOLD="2"

# TEST_DEDUP_ENABLED="true"

# TEST_FIX_FOCUS_ENABLED="true"

# =============================================================================
# Coder Stage  (7 variables)
# Senior/jr coder behavior and rework prompt selection.
# =============================================================================

# CODER_MAX_TURNS_CAP="200"

# CODER_MIN_TURNS="60"

# CODER_ROLE_FILE=".claude/agents/coder.md"

# CODER_SUMMARY_FILE=".tekhton/CODER_SUMMARY.md"

# CODER_TDD_TURN_MULTIPLIER="1.2"

# JR_CODER_ROLE_FILE=".claude/agents/jr-coder.md"

# JR_CODER_SUMMARY_FILE=".tekhton/JR_CODER_SUMMARY.md"

# =============================================================================
# Scout Sub-Stage  (5 variables)
# Complexity estimation that runs before each coder invocation.
# =============================================================================

# SCOUT_ON_BUG="always"

# SCOUT_ON_FEAT="auto"

# SCOUT_ON_POLISH="never"

# SCOUT_REPORT_FILE=".tekhton/SCOUT_REPORT.md"

# SCOUT_REPO_MAP_TOOLS_ONLY="true"

# =============================================================================
# Reviewer Stage  (5 variables)
# Review loop, rework routing, specialist trigger thresholds.
# =============================================================================

# REVIEWER_MAX_TURNS_CAP="60"

# REVIEWER_MIN_TURNS="20"

# REVIEWER_REPORT_FILE=".tekhton/REVIEWER_REPORT.md"

# REVIEWER_ROLE_FILE=".claude/agents/reviewer.md"

# REVIEW_SKIP_THRESHOLD="0"

# =============================================================================
# Tester Stage  (9 variables)
# Test writing + TDD pre-flight + post-test validation + tester-fix recursion.
# =============================================================================

# TESTER_FIX_ENABLED="false"

# TESTER_FIX_MAX_DEPTH="1"

# TESTER_FIX_MAX_TURNS="26"

# TESTER_FIX_OUTPUT_LIMIT="4000"

# TESTER_MAX_TURNS_CAP="120"

# TESTER_MIN_TURNS="30"

# TESTER_REPORT_FILE=".tekhton/TESTER_REPORT.md"

# TESTER_ROLE_FILE=".claude/agents/tester.md"

# TESTER_WRITE_FAILING_MAX_TURNS="15"

# =============================================================================
# Architect Stage & Drift Log  (10 variables)
# Pre-stage architect audit, drift observation thresholds, ADL paths, --fix drift loop.
# =============================================================================

# ARCHITECTURE_LOG_FILE=".tekhton/ARCHITECTURE_LOG.md"

# ARCHITECT_PLAN_FILE=".tekhton/ARCHITECT_PLAN.md"

# ARCHITECT_ROLE_FILE=".claude/agents/architect.md"

# DRIFT_ARCHIVE_FILE=".tekhton/DRIFT_ARCHIVE.md"

# DRIFT_LOG_FILE=".tekhton/DRIFT_LOG.md"

# DRIFT_OBSERVATION_THRESHOLD="8"

# DRIFT_RESOLVED_KEEP_COUNT="20"

# DRIFT_RUNS_SINCE_AUDIT_THRESHOLD="5"

# FIX_DRIFT_MAX_PASSES="3"

# HUMAN_ACTION_FILE=".tekhton/HUMAN_ACTION_REQUIRED.md"

# =============================================================================
# Intake Stage (PM Gate)  (7 variables)
# Task clarity scoring, verdict routing, historical-verdict injection.
# =============================================================================

# INTAKE_AGENT_ENABLED="true"

# INTAKE_AUTO_SPLIT="false"

# INTAKE_CLARITY_THRESHOLD="40"

# INTAKE_CONFIRM_TWEAKS="false"

